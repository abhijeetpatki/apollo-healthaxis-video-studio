# ------------------------------------------------------------------
# Apollo HealthAxis — AI Video Consultation Studio
# Copy to .env.local for local dev, or set these in Vercel project settings.
# ------------------------------------------------------------------

# === Vertex AI — two-way VIDEO avatar (gemini-3.8-live Live Avatar) ===
# The service-account JSON, as a single-line string (or base64-encoded).
GOOGLE_APPLICATION_CREDENTIALS_JSON=
# Your Google Cloud project id.
GOOGLE_CLOUD_PROJECT=
# Region that serves gemini-3.8-live Live Avatar.
GOOGLE_CLOUD_LOCATION=us-central1

# === AI Studio — voice + vision fallback (no video avatar) ===
# A Google AI Studio API key. If set, the studio works out-of-the-box
# even without Vertex credentials (audio + vision only).
GEMINI_API_KEY=
